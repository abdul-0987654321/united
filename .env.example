# Copy to .env for local development. On Render, set these under Environment - never commit real values.
# IMPORTANT: don't run the bot locally with the live WhatsApp number while Render is running it -
# two copies fight over the same session.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Apps Script web app (/exec URL) - code is in apps-script/Code.gs
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Must match the SECRET script property (or SHARED_SECRET) in the Apps Script
SHEETS_WEBAPP_SECRET=change-me-long-random-string

DASHBOARD_PASSWORD=change-me

BUSINESS_NAME=KSC Carpets
BUSINESS_WEBSITE=https://www.ksc-carpets.com
BUSINESS_GOOGLE_REVIEW_LINK=
BUSINESS_ADDRESS=
BUSINESS_PHONE=

# Optional
# PORT=3000
# DATA_DIR=./data
# FOLLOWUP_DEBUG=1
